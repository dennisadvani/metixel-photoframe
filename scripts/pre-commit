#!/bin/bash
# Git pre-commit hook — auto-bumps the Metixel Photoframe patch version.
#
# Install:  ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# Or copy:  cp scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

VERSION_FILE="src/metixel/__init__.py"

# Nothing staged (e.g. an empty or --allow-empty commit): nothing to bump.
if git diff --cached --quiet; then
    exit 0
fi

# Skip the auto-bump when this commit already changes the version line —
# release.sh's own "Bump version to X" commit stages src/metixel/__init__.py
# after bump_version.py wrote it, and bumping AGAIN here would move the
# committed version past the one the release branch/tag is named after.
if git diff --cached --name-only -- "${VERSION_FILE}" | grep -q .; then
    echo "[pre-commit] ${VERSION_FILE} is already staged — skipping auto version bump."
    exit 0
fi

# Belt and braces: a commit message that already announces a version bump
# (release.sh / release.ps1 use "Bump version to X").  Git writes the message
# file only after this hook runs, so it is only available when a tool passes
# it explicitly (e.g. GIT_COMMIT_MSG_FILE) — hence the staged-file check above
# is the primary guard.
MSG_FILE="${GIT_COMMIT_MSG_FILE:-}"
if [ -n "${MSG_FILE}" ] && [ -f "${MSG_FILE}" ] \
   && head -n 1 "${MSG_FILE}" | grep -q '^Bump version'; then
    echo "[pre-commit] Commit message starts with 'Bump version' — skipping auto version bump."
    exit 0
fi

python3 scripts/bump_version.py
git add "${VERSION_FILE}"
echo "[pre-commit] Version bumped automatically."
