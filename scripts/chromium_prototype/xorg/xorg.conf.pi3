Section "ServerFlags"
    Option "DontZap" "true"
    Option "DontVTSwitch" "true"
    Option "AutoAddGPU" "false"
EndSection

Section "Device"
    Identifier "Card0"
    Driver "modesetting"
    Option "kmsdev" "/dev/dri/card0"
EndSection

Section "Screen"
    Identifier "Screen0"
    Device "Card0"
EndSection