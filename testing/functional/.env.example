# Functional-test WiFi credentials.
#
# Copy this file to `.env` (same directory) and fill in the SSID/password of a
# real Wi-Fi network the Pi should connect to during functional tests.  The
# `.env` file is gitignored — never commit real credentials.
#
# The network must be in range of the Pi under test.  The tests connect to it,
# verify connectivity, then forget it (so the Pi returns to its prior state).
#
#   METIXEL_TEST_WIFI_SSID=MyTestNetwork
#   METIXEL_TEST_WIFI_PASSWORD=MySecretPassphrase
#
# Leave METIXEL_TEST_WIFI_PASSWORD empty for an open network.
METIXEL_TEST_WIFI_SSID=
METIXEL_TEST_WIFI_PASSWORD=