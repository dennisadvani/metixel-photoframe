# Functional-test WiFi credentials.
#
# Copy this file to `.env` (same directory) and fill in the SSID/password of a
# real Wi-Fi network the Pi should connect to during functional tests.  The
# `.env` file is gitignored — never commit real credentials.
#
# The network must be in range of the Pi under test.  The tests connect to it,
# verify connectivity, then forget it (so the Pi returns to its prior state).
#
#   METIXEL_TEST_WIFI_SSID=MyTestNetwork
#   METIXEL_TEST_WIFI_PASSWORD=MySecretPassphrase
#
# Leave METIXEL_TEST_WIFI_PASSWORD empty for an open network.
METIXEL_TEST_WIFI_SSID=
METIXEL_TEST_WIFI_PASSWORD=

# Immich sync test credentials + the two test albums to sync.
# Fill these in to enable the Immich functional test (test_immich.py).
#   METIXEL_TEST_IMMICH_URL=http://192.168.1.10:2283
#   METIXEL_TEST_IMMICH_API_KEY=your-api-key
#   METIXEL_TEST_IMMICH_ALBUM_1=AlbumNameOne
#   METIXEL_TEST_IMMICH_ALBUM_2=AlbumNameTwo
METIXEL_TEST_IMMICH_URL=
METIXEL_TEST_IMMICH_API_KEY=
METIXEL_TEST_IMMICH_ALBUM_1=
METIXEL_TEST_IMMICH_ALBUM_2=

# MQTT / Home Assistant broker test credentials.
# Fill in the broker host to enable the MQTT functional test (test_mqtt.py).
# Port defaults to 1883 when empty; username/password are optional (leave empty
# for an open local broker).
#   METIXEL_TEST_MQTT_BROKER=192.168.1.11
#   METIXEL_TEST_MQTT_PORT=1883
#   METIXEL_TEST_MQTT_USERNAME=
#   METIXEL_TEST_MQTT_PASSWORD=
METIXEL_TEST_MQTT_BROKER=
METIXEL_TEST_MQTT_PORT=1883
METIXEL_TEST_MQTT_USERNAME=
METIXEL_TEST_MQTT_PASSWORD=