[Unit]
Description=Metixel Photoframe Frontend Display Renderer
Documentation=https://github.com/dennisadvani/metixel-photoframe
After=metixel-backend.service
Requires=metixel-backend.service

[Service]
Type=simple
User=metixel
Group=video
WorkingDirectory=/opt/metixel/live
ExecStart=/usr/bin/python3 -m metixel --mode frontend --config /opt/metixel/data/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=METIXEL_DISPLAY_BACKEND=auto

# GPU access needed
SupplementaryGroups=video render input

# Security hardening (less strict than backend — needs GPU access)
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
