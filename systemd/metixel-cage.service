[Unit]
Description=Metixel Photoframe — Digital Photo Frame (cage + Wayland)
Documentation=https://github.com/dennisadvani/metixel-photoframe
After=metixel-backend.service seatd.service
Requires=metixel-backend.service
Wants=seatd.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input tty
WorkingDirectory=/opt/metixel/live
Environment=PYTHONPATH=/opt/metixel/live/src
Environment=PYTHONUNBUFFERED=1
Environment=METIXEL_DISPLAY_BACKEND=auto
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Ensure XDG_RUNTIME_DIR exists for cage's Wayland socket.
# The '+' prefix runs these as root before dropping to User=pi.
# loginctl enable-linger pi (run once at setup) ensures systemd-logind
# creates /run/user/1000 on boot even without a user login.
ExecStartPre=+/bin/mkdir -p /run/user/1000
ExecStartPre=+/bin/chown pi:pi /run/user/1000
ExecStartPre=+/bin/chmod 0700 /run/user/1000

# cage starts a Wayland session with XWayland, then runs metixel inside it.
# This gives pi3d the X11 surface it needs on KMS-only systems (Trixie).
# -d: suppress the compositor's seat cursor entirely (no cursor on screen).
# The cage_launch.sh wrapper disables phantom HDMI outputs (no EDID) BEFORE
# the frontend connects to XWayland, so the frame renders at the real
# monitor's native resolution (fixes aspect-ratio distortion on Pi 5 with
# an empty second HDMI port).
ExecStart=/usr/bin/cage -d -- /opt/metixel/live/scripts/cage_launch.sh

# Restart on failure or exit
Restart=always
RestartSec=5

# Security (relaxed — cage needs GPU + input access)
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
