[Unit]
Description=Metixel Photoframe — Digital Photo Frame (cage + Wayland)
Documentation=https://github.com/dennisadvani/metixel-photoframe
After=metixel-backend.service seatd.service
Requires=metixel-backend.service
Wants=seatd.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input tty
WorkingDirectory=/opt/metixel/live
Environment=PYTHONPATH=/opt/metixel/live/src
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Pin Qt to the Wayland platform plugin — DO NOT remove or replace with
# auto-detection.  Qt picks a QPA plugin at runtime: `wayland` talks to cage
# directly, whereas `xcb` needs an X server (XWayland).  Left to auto-detect,
# a missing Wayland plugin silently degrades to `xcb`, which on a frame with
# no X server is a BLACK SCREEN at boot with nothing in the log to explain it.
# Pinning turns that into a loud, immediate startup failure that the OTA health
# gate catches and rolls back.
#
# This makes `libqt6waylandclient6` a REQUIRED system package (see
# requirements-system.txt).  If it is missing, Qt aborts on startup — which is
# the intended, diagnosable behaviour.
Environment=QT_QPA_PLATFORM=wayland

# Ensure XDG_RUNTIME_DIR exists for cage's Wayland socket.
# The '+' prefix runs these as root before dropping to User=pi.
# loginctl enable-linger pi (run once at setup) ensures systemd-logind
# creates /run/user/1000 on boot even without a user login.
ExecStartPre=+/bin/mkdir -p /run/user/1000
ExecStartPre=+/bin/chown pi:pi /run/user/1000
ExecStartPre=+/bin/chmod 0700 /run/user/1000

# cage is the Wayland compositor; metixel runs as its single client.
# -d: suppress the compositor's seat cursor entirely (no cursor on screen).
#
# cage_launch.sh disables phantom HDMI outputs (a port reporting "connected"
# with no EDID) BEFORE the frontend starts.  That is REQUIRED for correct
# aspect ratio and is unrelated to X11: cage enables every output the DRM layer
# reports, so an empty second HDMI port widens the compositor's surface (e.g.
# 1920 + 1024 = 2944px) and the frontend renders a 2944x1200 canvas that cage
# then scales back down — distorting the slideshow.  See scripts/cage_launch.sh.
# cage_launch.sh also triggers the cursor-hider before the compositor starts
# (single source of truth, launch-method agnostic).
ExecStart=/usr/bin/cage -d -- /opt/metixel/live/scripts/cage_launch.sh

# Restart on failure or exit
Restart=always
RestartSec=5

# Security (relaxed — cage needs GPU + input access)
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
