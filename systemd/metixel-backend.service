[Unit]
Description=Metixel Photoframe Backend Daemon
Documentation=https://github.com/dennisadvani/metixel-photoframe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/metixel/live
Environment=PYTHONPATH=/opt/metixel/live/src
Environment=PYTHONUNBUFFERED=1
Environment=METIXEL_DISPLAY_BACKEND=auto

# systemd creates /run/metixel before namespace setup (avoids 226/NAMESPACE)
RuntimeDirectory=metixel
RuntimeDirectoryMode=0755

# Ensure the persistent data dirs exist and are owned by pi.  A
# root-created metixel.log (e.g. from a one-off root run during install)
# would otherwise make this pi-run service crash-loop with
#   PermissionError: .../data/logs/metixel.log
# The '+' prefix runs as root so it can chown files that were created by
# root.  mkdir -p is idempotent; chown fixes the log-dir ownership on every
# (re)start.  Scoped to data/logs (not -R over all of data) so big media
# trees aren't walked on each restart.
ExecStartPre=+/bin/mkdir -p /opt/metixel/data/logs /opt/metixel/data/cache /opt/metixel/data/config /opt/metixel/data/media /opt/metixel/data/backups
ExecStartPre=+/usr/bin/chown -R pi:pi /opt/metixel/data/logs
ExecStart=/usr/bin/python3 -m metixel --mode backend --config /opt/metixel/data/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Limit total process memory — the kernel will OOM-kill the backend
# (and all its children, including ffmpeg) before the whole system
# runs out of swap.  On a Pi 3 (1 GB) this leaves ~256 MB for the OS.
MemoryMax=768M

# Security hardening
# NOTE: NoNewPrivileges is NOT set because the backend needs to run
# privileged commands via sudo for AP mode (hostapd/dnsmasq control).
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/metixel/releases /opt/metixel/data /opt/metixel/live /tmp /boot/firmware /etc/systemd /etc/sysctl.d

[Install]
WantedBy=multi-user.target
