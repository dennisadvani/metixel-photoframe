[Unit]
Description=Metixel Photoframe Backend Daemon
Documentation=https://github.com/denni/metixel-photoframe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/metixel
Environment=PYTHONPATH=/opt/metixel
Environment=PYTHONUNBUFFERED=1
Environment=METIXEL_DISPLAY_BACKEND=auto

# systemd creates /run/metixel before namespace setup (avoids 226/NAMESPACE)
RuntimeDirectory=metixel
RuntimeDirectoryMode=0755

ExecStartPre=/bin/mkdir -p /opt/metixel/logs /opt/metixel/cache
ExecStart=/usr/bin/python3 -m metixel --mode backend --config /opt/metixel/etc/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Limit total process memory — the kernel will OOM-kill the backend
# (and all its children, including ffmpeg) before the whole system
# runs out of swap.  On a Pi 3 (1 GB) this leaves ~256 MB for the OS.
MemoryMax=768M

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/metixel /tmp

[Install]
WantedBy=multi-user.target
