[Unit]
Description=Metixel Photoframe Backend Daemon
Documentation=https://github.com/dennisadvani/metixel-photoframe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/metixel/live
Environment=PYTHONPATH=/opt/metixel/live/src
Environment=PYTHONUNBUFFERED=1
Environment=METIXEL_DISPLAY_BACKEND=auto

# ddcutil persists its cached capabilities + performance stats under
# $XDG_CACHE_HOME (else $HOME/.cache).  Two reasons this MUST be set here:
#   1. ProtectHome=yes makes /home read-only for this service, so ddcutil's
#      default cache is unusable — every probe would re-run the slow I²C
#      sleep/retry timing and can exceed the ddcutil timeout entirely.
#   2. This unit is the single source of truth for the location.  The code no
#      longer hardcodes the path, so what ships in the release and what the
#      service actually uses can never drift apart.
# ddcutil appends its own `ddcutil/` subdirectory, giving
# /opt/metixel/data/cache/ddcutil/ddcutil/.
Environment=XDG_CACHE_HOME=/opt/metixel/data/cache/ddcutil

# systemd creates /run/metixel before namespace setup (avoids 226/NAMESPACE).
# This is systemd's own mechanism and must stay in the unit — the socket dir has
# to exist before the service starts, on every boot, without an installer.
RuntimeDirectory=metixel
RuntimeDirectoryMode=0755

# NOTE: the persistent data tree (data/logs, data/media, data/cache, data/etc,
# …) is NOT created here.  scripts/reconcile.sh is the single owner of that
# tree — it creates the directories and repairs ownership left root-owned by an
# install.  Duplicating the list in the unit is what previously caused drift
# (the unit created a `data/config` directory that does not exist by design).
# reconcile.sh runs before the service starts on both the fresh-install and the
# OTA path, so the tree is always in place by the time this unit launches.
ExecStart=/usr/bin/python3 -m metixel --mode backend --config /opt/metixel/data/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Limit total process memory — the kernel will OOM-kill the backend
# (and all its children, including ffmpeg) before the whole system
# runs out of swap.  On a Pi 3 (1 GB) this leaves ~256 MB for the OS.
MemoryMax=768M

# Security hardening
# NOTE: NoNewPrivileges is NOT set because the backend needs to run
# privileged commands via sudo for AP mode (hostapd/dnsmasq control).
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/metixel/releases /opt/metixel/data /opt/metixel/live /tmp /boot/firmware /etc/systemd /etc/sysctl.d

[Install]
WantedBy=multi-user.target
